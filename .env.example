# =============================================================================
# LinkGround — env template  (copy to .env and fill in secrets)
#   copy .env.example .env
# =============================================================================

# --- API server --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Open PageRank (prestige) ------------------------------------------------
# Required for live authority scores
OPR_API_KEY=opr_live_replace_me
OPR_BULK_URL=https://openpagerank.keywordseverywhere.com/v1/domains/bulk

# --- Judge (primary scoring model) -------------------------------------------
# Pick ONE backend. Empty JUDGE_BASE_URL => local Ollama.

# LLM7 (recommended)  https://dash.llm7.io
JUDGE_BASE_URL=https://api.llm7.io/v1
JUDGE_API_KEY=unused
DEFAULT_ANALYST_MODEL=default
# With a dashboard token, prefer e.g. mistral-Nemo-Instruct-2407
# JUDGE_API_KEY=your_llm7_token
# DEFAULT_ANALYST_MODEL=mistral-Nemo-Instruct-2407

JUDGE_MAX_TOKENS=512
DEFAULT_JUDGE_RUNS=1

# Groq  https://console.groq.com
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=gsk_replace_me
# DEFAULT_ANALYST_MODEL=openai/gpt-oss-20b

# Local Ollama only
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# DEFAULT_ANALYST_MODEL=llama3.1

# --- Local Ollama (claim split / offline) ------------------------------------
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate
LOCAL_SPLIT_MODEL=llama3.1

# --- Pipeline tuning ---------------------------------------------------------
EVIDENCE_CHAR_BUDGET=2500
FALLBACK_EVIDENCE_FACTOR=0.6
DISCOVERY_SCORE_FACTOR=0.55
DISCOVERY_MAX_URLS=4
DISCOVERY_DEPTH=1
DISCOVERY_MAX_PAGES=12
CACHE_TTL_SECONDS=604800
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
